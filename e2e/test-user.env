# Single source of truth for e2e test configuration.
#
# Consumers:
#   - setup-db.sh (shell)        — sources this file and forwards the
#                                  TEST_USER_* vars into seed_test_data.py.
#   - seed_test_data.py (Python) — reads the same vars via os.environ to
#                                  seed the User / Student / FinalExam rows.
#   - tests/test-config.ts (TS)  — parses this file and re-exports the
#                                  values as constants used by the specs.
#
# Edit values here — they propagate to the DB seed and the Playwright tests
# in lockstep.

# Paths
# Relative to the directory containing this file; setup-db.sh anchors it
# to its own script location, so the value works regardless of CWD.
# Current folder structure:
# - mobile/
#   - e2e/
#     - test-user.env
# - backend/
BACKEND_DIR=../../backend

# Web app base URL used by the Playwright tests
TEST_BASE_URL=http://localhost:8081
TEST_BACKEND_URL=http://localhost:8007

# Test user credentials (exported to the backend container)
TEST_USER_DNI=00000001
TEST_USER_EMAIL=user.test@ludo.com
TEST_USER_PADRON=00001
TEST_USER_PASSWORD=pelusa22

# Display name shown by the credential / header components — asserted by
# user.spec.ts, navigation.spec.ts, and auth.spec.ts.
TEST_USER_FIRST_NAME=Joe
TEST_USER_LAST_NAME=Doe
